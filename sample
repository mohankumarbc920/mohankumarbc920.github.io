<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mohan Kumar — AI/ML Engineer</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #e8edf3;
  --card: #f2f5f9;
  --card2: #dde3ec;
  --border: rgba(100,120,160,0.15);
  --text: #1e2a3a;
  --muted: #5a6a80;
  --a1: #4a72c4;
  --a2: #e05c8a;
  --a3: #1aaa80;
  --a4: #d4900a;
  --a5: #2d8fbf;
  --glow1: rgba(74,114,196,0.18);
  --glow2: rgba(224,92,138,0.14);
  --glow3: rgba(26,170,128,0.14);
  --r: 16px;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text);line-height:1.7;overflow-x:hidden;}

::-webkit-scrollbar{width:6px;}
::-webkit-scrollbar-track{background:var(--bg);}
::-webkit-scrollbar-thumb{background:var(--a1);border-radius:99px;}

body::before{
  content:'';position:fixed;inset:0;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.025'/%3E%3C/svg%3E");
  pointer-events:none;z-index:0;opacity:.3;
}

/* NAV */
nav{
  position:sticky;top:0;z-index:100;
  background:rgba(232,237,243,0.88);backdrop-filter:blur(20px);
  border-bottom:1px solid var(--border);
  display:flex;justify-content:space-between;align-items:center;
  padding:0 2.5rem;height:62px;
}
.nav-logo{
  font-family:'Space Grotesk',sans-serif;font-weight:800;font-size:1.1rem;
  background:linear-gradient(90deg,var(--a1),var(--a2));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
  letter-spacing:-.02em;
}
.nav-links{display:flex;gap:1.75rem;list-style:none;}
.nav-links a{
  text-decoration:none;color:var(--muted);font-size:.82rem;font-weight:500;
  letter-spacing:.04em;text-transform:uppercase;transition:color .2s;
}
.nav-links a:hover{color:var(--text);}

/* HERO */
.hero{
  min-height:100vh;display:flex;align-items:center;justify-content:center;
  padding:6rem 2rem;text-align:center;position:relative;overflow:hidden;
  background:linear-gradient(160deg,#dce4f0 0%,#e8edf3 40%,#d8e8f0 100%);
}
.hero-bg{
  position:absolute;inset:0;
  background:
    radial-gradient(ellipse 60% 50% at 20% 40%,rgba(74,114,196,.12) 0%,transparent 60%),
    radial-gradient(ellipse 50% 40% at 80% 30%,rgba(224,92,138,.08) 0%,transparent 55%),
    radial-gradient(ellipse 50% 50% at 60% 80%,rgba(26,170,128,.09) 0%,transparent 55%);
}
.orb{position:absolute;border-radius:50%;filter:blur(70px);animation:float 8s ease-in-out infinite;}
.orb1{width:320px;height:320px;background:rgba(74,114,196,.15);top:-80px;left:-80px;animation-delay:0s;}
.orb2{width:260px;height:260px;background:rgba(224,92,138,.1);bottom:40px;right:-60px;animation-delay:3s;}
.orb3{width:220px;height:220px;background:rgba(26,170,128,.1);bottom:20%;left:60%;animation-delay:5s;}
@keyframes float{0%,100%{transform:translateY(0) scale(1);}50%{transform:translateY(-20px) scale(1.05);}}

.hero-inner{position:relative;max-width:750px;}
.status-pill{
  display:inline-flex;align-items:center;gap:.5rem;
  background:rgba(26,170,128,0.1);border:1px solid rgba(26,170,128,.3);
  color:var(--a3);font-size:.78rem;font-weight:600;letter-spacing:.05em;
  padding:.35rem 1rem;border-radius:999px;margin-bottom:2rem;
  text-transform:uppercase;
}
.status-dot{width:7px;height:7px;background:var(--a3);border-radius:50%;animation:pulse 2s infinite;}
@keyframes pulse{0%,100%{opacity:1;box-shadow:0 0 0 0 rgba(26,170,128,.4);}50%{opacity:.7;box-shadow:0 0 0 6px rgba(26,170,128,0);}}

.avatar{
  width:110px;height:110px;border-radius:50%;margin:0 auto 1.75rem;
  background:linear-gradient(135deg,var(--a1),var(--a2),var(--a4));
  display:flex;align-items:center;justify-content:center;
  font-family:'Space Grotesk',sans-serif;font-size:2.2rem;font-weight:800;color:white;
  box-shadow:0 0 0 3px rgba(74,114,196,.15),0 0 40px var(--glow1);
  position:relative;
}
.avatar::after{
  content:'';position:absolute;inset:-4px;border-radius:50%;
  background:linear-gradient(135deg,var(--a1),var(--a2),var(--a4));
  z-index:-1;filter:blur(12px);opacity:.3;
}

.hero h1{
  font-family:'Space Grotesk',sans-serif;
  font-size:clamp(2.4rem,6vw,4rem);font-weight:800;
  line-height:1.1;margin-bottom:.5rem;letter-spacing:-.03em;color:var(--text);
}
.hero h1 .grad{
  background:linear-gradient(135deg,var(--a1) 0%,var(--a2) 50%,var(--a4) 100%);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
}
.hero-role{font-size:1.1rem;color:var(--muted);margin-bottom:.5rem;font-weight:400;}
.hero-loc{font-size:.88rem;color:var(--muted);margin-bottom:2rem;display:flex;align-items:center;justify-content:center;gap:.75rem;flex-wrap:wrap;}
.hero-loc span{display:flex;align-items:center;gap:.3rem;}
.hero-loc svg{width:14px;height:14px;opacity:.6;}

.hero-stats{display:flex;justify-content:center;gap:2.5rem;margin-bottom:2rem;flex-wrap:wrap;}
.stat{text-align:center;}
.stat-num{
  font-family:'Space Grotesk',sans-serif;font-size:1.6rem;font-weight:800;
  background:linear-gradient(135deg,var(--a1),var(--a3));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
}
.stat-label{font-size:.75rem;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;margin-top:.1rem;}

.hero-tags{display:flex;flex-wrap:wrap;gap:.6rem;justify-content:center;margin-bottom:2.5rem;}
.htag{padding:.3rem .9rem;border-radius:999px;font-size:.78rem;font-weight:600;border:1px solid;letter-spacing:.02em;}
.ht1{background:rgba(74,114,196,.1);border-color:rgba(74,114,196,.3);color:var(--a1);}
.ht2{background:rgba(224,92,138,.1);border-color:rgba(224,92,138,.3);color:var(--a2);}
.ht3{background:rgba(26,170,128,.1);border-color:rgba(26,170,128,.3);color:var(--a3);}
.ht4{background:rgba(212,144,10,.1);border-color:rgba(212,144,10,.3);color:var(--a4);}
.ht5{background:rgba(45,143,191,.1);border-color:rgba(45,143,191,.3);color:var(--a5);}

.hero-cta{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;}
.btn{
  display:inline-flex;align-items:center;gap:.5rem;
  padding:.75rem 1.75rem;border-radius:999px;font-size:.88rem;font-weight:600;
  text-decoration:none;transition:all .25s;border:none;cursor:pointer;letter-spacing:.01em;
}
.btn-glow{background:linear-gradient(135deg,var(--a1),#6b8fd4);color:white;box-shadow:0 4px 20px rgba(74,114,196,.35);}
.btn-glow:hover{transform:translateY(-3px);box-shadow:0 8px 32px rgba(74,114,196,.45);}
.btn-ghost{background:rgba(74,114,196,.08);color:var(--text);border:1px solid var(--border);}
.btn-ghost:hover{background:rgba(74,114,196,.15);transform:translateY(-3px);}

/* SECTION */
.sw{max-width:960px;margin:0 auto;padding:5rem 2rem;}
.sh{margin-bottom:2.5rem;}
.sl{
  display:inline-flex;align-items:center;gap:.5rem;
  font-size:.73rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;
  color:var(--a1);margin-bottom:.6rem;
}
.sl::before{content:'';display:block;width:24px;height:2px;background:linear-gradient(90deg,var(--a1),var(--a2));border-radius:2px;}
.st{font-family:'Space Grotesk',sans-serif;font-size:clamp(1.6rem,3vw,2.1rem);font-weight:800;letter-spacing:-.02em;color:var(--text);}

/* ABOUT */
.about-lead{
  font-size:1.05rem;line-height:1.85;color:#1e2a3a;margin-bottom:2rem;
  padding:1.5rem;background:rgba(74,114,196,.06);border:1px solid rgba(74,114,196,.15);
  border-radius:var(--r);border-left:3px solid var(--a1);
}
.competency-wrap{margin-bottom:2rem;}
.competency-wrap h4{font-size:.8rem;text-transform:uppercase;letter-spacing:.1em;color:#3a4a60;margin-bottom:.75rem;}
.comp-chips{display:flex;flex-wrap:wrap;gap:.45rem;}
.cc{font-size:.78rem;padding:.25rem .75rem;border-radius:999px;font-weight:500;background:rgba(74,114,196,.08);border:1px solid rgba(74,114,196,.2);color:#1e2a3a;}
.about-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;}
.ac{
  background:var(--card);border:1px solid var(--border);border-radius:var(--r);
  padding:1.25rem;display:flex;flex-direction:column;gap:.4rem;
  transition:transform .2s,border-color .2s;
}
.ac:hover{transform:translateY(-3px);border-color:rgba(74,114,196,.35);}
.ac-icon{font-size:1.4rem;color:var(--a1);}
.ac-num{font-family:'Space Grotesk',sans-serif;font-size:1.5rem;font-weight:800;color:var(--a1);}
.ac-label{font-size:.8rem;color:var(--muted);}

/* EXPERIENCE */
.timeline{position:relative;padding-left:2rem;}
.timeline::before{
  content:'';position:absolute;left:0;top:12px;bottom:0;width:2px;
  background:linear-gradient(to bottom,var(--a1),var(--a2),var(--a3));border-radius:2px;
}
.ei{position:relative;margin-bottom:2rem;}
.ei::before{
  content:'';position:absolute;left:-2.38rem;top:12px;
  width:14px;height:14px;border-radius:50%;
  background:var(--bg);border:2.5px solid var(--a1);
  box-shadow:0 0 10px var(--glow1);
}
.ec{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:1.5rem;transition:transform .2s,border-color .2s,box-shadow .2s;}
.ec:hover{transform:translateX(4px);border-color:rgba(74,114,196,.3);box-shadow:0 4px 24px var(--glow1);}
.ec-header{display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:.5rem;margin-bottom:.75rem;}
.ec-title{font-family:'Space Grotesk',sans-serif;font-size:1rem;font-weight:700;color:var(--text);}
.ec-org{color:var(--a1);font-weight:600;font-size:.875rem;margin-top:.15rem;}
.ec-date{background:rgba(74,114,196,.1);border:1px solid rgba(74,114,196,.25);color:var(--a1);font-size:.73rem;font-weight:600;padding:.25rem .75rem;border-radius:999px;white-space:nowrap;}
.ec ul{padding-left:1.2rem;}
.ec li{font-size:.855rem;color:#1e2a3a;margin-bottom:.45rem;line-height:1.6;}
.ec li strong{color:var(--a3);}
.metrics{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:.75rem;}
.metric{display:inline-flex;align-items:center;gap:.3rem;font-size:.75rem;font-weight:700;padding:.2rem .65rem;border-radius:999px;}
.m-green{background:rgba(26,170,128,.1);border:1px solid rgba(26,170,128,.3);color:var(--a3);}
.m-purple{background:rgba(74,114,196,.1);border:1px solid rgba(74,114,196,.3);color:var(--a1);}
.m-pink{background:rgba(224,92,138,.1);border:1px solid rgba(224,92,138,.3);color:var(--a2);}
.m-yellow{background:rgba(212,144,10,.1);border:1px solid rgba(212,144,10,.3);color:var(--a4);}

/* PROJECTS */
.pg{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.25rem;}
.pc{
  background:var(--card);border:1px solid var(--border);border-radius:var(--r);
  padding:1.5rem;display:flex;flex-direction:column;gap:.75rem;
  transition:transform .2s,box-shadow .2s,border-color .2s;position:relative;overflow:hidden;
}
.pc:hover{transform:translateY(-5px);}
.pc1{border-top:2px solid var(--a1);}
.pc1:hover{box-shadow:0 16px 48px var(--glow1);}
.pc2{border-top:2px solid var(--a2);}
.pc2:hover{box-shadow:0 16px 48px var(--glow2);}
.pc-icon{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;}
.pc-icon svg{width:20px;height:20px;}
.pc-icon-blue{background:rgba(74,114,196,.12);}
.pc-icon-blue svg{color:var(--a1);}
.pc-icon-pink{background:rgba(224,92,138,.12);}
.pc-icon-pink svg{color:var(--a2);}
.pc-icon-green{background:rgba(26,170,128,.12);}
.pc-icon-green svg{color:var(--a3);}
.pc-icon-yellow{background:rgba(212,144,10,.12);}
.pc-icon-yellow svg{color:var(--a4);}
.pc-title{font-family:'Space Grotesk',sans-serif;font-size:1rem;font-weight:700;line-height:1.3;color:var(--text);}
.pc-chips{display:flex;flex-wrap:wrap;gap:.35rem;}
.pchip{font-size:.72rem;font-weight:600;padding:.2rem .6rem;border-radius:999px;background:rgba(74,114,196,.07);color:var(--muted);border:1px solid var(--border);}
.pc-desc{font-size:.845rem;color:#3a4a5c;line-height:1.65;flex-grow:1;}

/* PUBLICATION */
.pub{
  background:var(--card);border:1px solid rgba(74,114,196,.2);border-radius:20px;
  padding:2rem;display:flex;gap:1.5rem;align-items:flex-start;
  box-shadow:0 0 32px rgba(74,114,196,.06);transition:transform .2s,box-shadow .2s;
}
.pub:hover{transform:translateY(-3px);box-shadow:0 8px 40px rgba(74,114,196,.12);}
.pub-badge{
  background:linear-gradient(135deg,var(--a1),var(--a2));color:white;
  font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;
  padding:.5rem .9rem;border-radius:12px;flex-shrink:0;text-align:center;line-height:1.4;min-width:80px;
}
.pub-title{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:1rem;margin-bottom:.4rem;line-height:1.4;color:var(--text);}
.pub-authors{font-size:.82rem;color:var(--muted);margin-bottom:.3rem;}
.pub-venue{font-size:.82rem;font-weight:600;color:var(--a1);margin-bottom:.75rem;}
.pub-link{
  display:inline-flex;align-items:center;gap:.4rem;
  color:var(--a2);font-size:.82rem;font-weight:600;text-decoration:none;
  padding:.35rem .9rem;border-radius:999px;border:1px solid rgba(224,92,138,.3);
  background:rgba(224,92,138,.07);transition:all .2s;
}
.pub-link:hover{background:rgba(224,92,138,.15);transform:translateX(3px);}
.pub-link svg{width:14px;height:14px;}

/* SKILLS */
.skills-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem;}
.skcard{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:1.25rem;transition:transform .2s,border-color .2s;}
.skcard:hover{transform:translateY(-3px);border-color:rgba(74,114,196,.3);}
.skcard-head{display:flex;align-items:center;gap:.6rem;margin-bottom:.85rem;}
.skcard-icon{width:30px;height:30px;display:flex;align-items:center;justify-content:center;border-radius:8px;}
.skcard-icon svg{width:16px;height:16px;}
.skcard h3{font-size:.88rem;font-weight:700;color:var(--text);}
.sk-chips{display:flex;flex-wrap:wrap;gap:.35rem;}
.skchip{font-size:.75rem;padding:.22rem .65rem;border-radius:999px;font-weight:500;border:1px solid;}
.sk1{background:rgba(74,114,196,.1);border-color:rgba(74,114,196,.25);color:#2a4a8a;}
.sk2{background:rgba(224,92,138,.1);border-color:rgba(224,92,138,.25);color:#a03060;}
.sk3{background:rgba(26,170,128,.1);border-color:rgba(26,170,128,.25);color:#0d7a5a;}
.sk4{background:rgba(212,144,10,.1);border-color:rgba(212,144,10,.25);color:#8a5a00;}
.sk5{background:rgba(45,143,191,.1);border-color:rgba(45,143,191,.25);color:#1a5f80;}

/* EDUCATION */
.edu-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.25rem;}
.educ{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:1.5rem;position:relative;overflow:hidden;transition:transform .2s;}
.educ:hover{transform:translateY(-3px);}
.educ::after{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--a1),var(--a2),var(--a4));}
.educ-icon{width:40px;height:40px;border-radius:10px;background:rgba(74,114,196,.1);display:flex;align-items:center;justify-content:center;margin-bottom:.75rem;}
.educ-icon svg{width:22px;height:22px;color:var(--a1);}
.educ-deg{font-family:'Space Grotesk',sans-serif;font-size:.975rem;font-weight:700;margin-bottom:.3rem;color:var(--text);}
.educ-uni{color:var(--a1);font-weight:600;font-size:.85rem;margin-bottom:.25rem;}
.educ-date{font-size:.78rem;color:var(--muted);margin-bottom:.5rem;}
.educ-courses{font-size:.8rem;color:#3a4a5c;background:rgba(74,114,196,.05);border-radius:8px;padding:.65rem;border:1px solid var(--border);margin-top:.5rem;}

/* CONTACT */
.contact-strip{
  background:linear-gradient(135deg,rgba(74,114,196,.1),rgba(224,92,138,.07));
  border:1px solid rgba(74,114,196,.2);border-radius:20px;
  padding:2.5rem;text-align:center;
}
.contact-strip h2{font-family:'Space Grotesk',sans-serif;font-size:1.75rem;font-weight:800;margin-bottom:.5rem;color:var(--text);}
.contact-strip p{color:var(--muted);margin-bottom:1.5rem;}
.contact-btns{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;}

/* FOOTER */
footer{border-top:1px solid var(--border);padding:2rem;text-align:center;color:var(--muted);font-size:.82rem;}
footer a{color:var(--a1);text-decoration:none;font-weight:500;}
footer a:hover{color:var(--a3);}
.footer-links{display:flex;justify-content:center;gap:1.5rem;margin-bottom:.75rem;flex-wrap:wrap;}

@media(max-width:640px){
  nav{padding:0 1rem;}
  .nav-links{gap:1rem;}
  .nav-links a{font-size:.75rem;}
  .hero-stats{gap:1.5rem;}
  .pub{flex-direction:column;}
}
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <div class="nav-logo">MK</div>
  <ul class="nav-links">
    <li><a href="#about">About</a></li>
    <li><a href="#experience">Experience</a></li>
    <li><a href="#projects">Projects</a></li>
    <li><a href="#publications">Research</a></li>
    <li><a href="#skills">Skills</a></li>
    <li><a href="#education">Education</a></li>
  </ul>
</nav>

<!-- HERO -->
<div class="hero">
